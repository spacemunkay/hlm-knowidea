# Required for AI matching + idea generation. Without it the app runs in a
# deterministic fallback mode (useful for testing).
GEMINI_API_KEY=
# Any Gemini model id. "gemini-flash-latest" tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional fixed public URL for the QR code. Leave blank to use whatever URL the
# page was opened from (works with `npm run share`, whose tunnel URL changes each run).
PUBLIC_URL=
PORT=3000

# Protects /admin. Required (and must not be change-me) for `npm run share`.
ADMIN_TOKEN=change-me

# Optional: pre-load the hackathon page to scrape on first boot.
HACKATHON_URL=
