# Required for AI matching + idea generation. Without it the app runs in a
# deterministic fallback mode (useful for testing).
GEMINI_API_KEY=
# Any Gemini model id. "gemini-flash-latest" tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Public URL participants will reach (used for the QR code).
PUBLIC_URL=http://localhost:3000
PORT=3000

# Protects /admin. Change this!
ADMIN_TOKEN=change-me

# Optional: pre-load the hackathon page to scrape on first boot.
HACKATHON_URL=
