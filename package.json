{
  "name": "hackathon-teamer",
  "version": "1.0.0",
  "description": "Streaming, AI-assisted team formation and project ideas for day-long hackathons (Gemini-powered).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
